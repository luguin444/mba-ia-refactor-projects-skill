# Copie para .env e preencha. Nenhum valor real é versionado.

# Assina as sessões. Sem ela, o boot gera uma chave efêmera e avisa no log.
SECRET_KEY=

# Origens liberadas no CORS, separadas por vírgula.
# Vazio libera todas as origens e emite aviso no boot.
CORS_ORIGINS=http://localhost:3000

DATABASE_URI=sqlite:///tasks.db

DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
