# Copie para .env e preencha. O .env está no .gitignore da raiz do repositório.
# Nenhuma destas variáveis tem valor sensível embutido no código (AP-03).

# Porta HTTP. Default: 3000
PORT=3000

# development | production. Em production o seed não roda. Default: development
NODE_ENV=development

# error | warn | info | debug. Default: info
LOG_LEVEL=info

# Chave do gateway de pagamento. Sem ela a autorização roda em modo stub e o
# PaymentService avisa no boot. Não existe default: segredo com fallback no
# código é segredo hardcoded com uma indireção a mais.
PAYMENT_GATEWAY_KEY=
