# Copy to .env and fill in. `npm start` loads .env when it exists.

PORT=3000
# SQLite path; ":memory:" keeps the database in memory (lost on restart).
DB_PATH=:memory:
# Load the example data on boot. Set to false for an empty database.
SEED_ON_BOOT=true
LOG_LEVEL=info

# Signs the login tokens. Without it, an ephemeral secret is generated on boot.
JWT_SECRET=

# Admin account provisioned on boot. Without both, no admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payment gateway credential. Authorization still runs in STUB mode.
PAYMENT_GATEWAY_KEY=
