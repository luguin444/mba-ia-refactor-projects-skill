@baseUrl = http://localhost:3000

### Checkout - sucesso (público: é o checkout que cria a conta)
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Login - admin (ADMIN_EMAIL / ADMIN_PASSWORD do ambiente)
# @name adminLogin
POST {{baseUrl}}/api/login
Content-Type: application/json

{
  "eml": "admin@exemplo.com",
  "pwd": "troque-esta-senha"
}

### Login - aluno do seed
# @name studentLogin
POST {{baseUrl}}/api/login
Content-Type: application/json

{
  "eml": "leonan@fullcycle.com.br",
  "pwd": "123"
}

### Relatório financeiro administrativo (exige admin)
GET {{baseUrl}}/api/admin/financial-report
Authorization: Bearer {{adminLogin.response.body.token}}

### Deletar usuário (exige ser o próprio usuário ou admin)
DELETE {{baseUrl}}/api/users/1
Authorization: Bearer {{studentLogin.response.body.token}}
