# Copie para .env e ajuste. O .env não é versionado.
# Sem valor definido, a aplicação gera uma chave efêmera a cada boot.
SECRET_KEY=

DEBUG=false
HOST=127.0.0.1
PORT=5000

DATABASE_PATH=loja.db

# Lista separada por vírgula. Vazio = nenhuma origem cross-site liberada.
CORS_ORIGINS=

LOG_LEVEL=INFO
SEED_ON_BOOT=true
