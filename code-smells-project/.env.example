# Copie para .env e preencha. Sem SECRET_KEY, uma chave efêmera é gerada a cada boot (com aviso).
SECRET_KEY=
DEBUG=false
APP_ENV=producao
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
# true: cria produtos e usuários de exemplo (inclui admin@loja.com / admin123) se o banco estiver vazio
SEED_ON_BOOT=true
# lista separada por vírgula; vazio ou * libera todas as origens
CORS_ORIGINS=
LOG_LEVEL=INFO
TOKEN_TTL_HORAS=12
